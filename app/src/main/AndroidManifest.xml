<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:icon="@android:drawable/ic_menu_gallery"
        android:theme="@style/Theme.SwipeGallery">

        <activity
            android:name=".ui.LanguageActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.OnboardingActivity" android:exported="false" />
        <activity android:name=".ui.PickerActivity" android:exported="false" />
        <activity android:name=".ui.SwipeActivity" android:exported="false" />
        <activity android:name=".ui.TrashActivity" android:exported="false" />
        <activity android:name=".ui.PermissionActivity" android:exported="false" />

    </application>
</manifest>
